<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A sandboxed Mac app cannot reach the printing system without this;
	     without it AppKit reports "This application does not support printing."
	     Ignored on iOS, which doesn't use App Sandbox entitlements. -->
	<key>com.apple.security.print</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.us.c20d.GnimuMonitor</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.us.c20d.GnimuMonitor</string>
	</array>
</dict>
</plist>
